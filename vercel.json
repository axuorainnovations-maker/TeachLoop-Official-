{
  "version": 2,
  "routes": [
    {
      "src": "/config.js",
      "dest": "/api/index.py"
    },
    {
      "src": "/supabase-config.js",
      "dest": "/api/index.py"
    },
    {
      "src": "/v1/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/create-checkout-session",
      "dest": "/api/index.py"
    },
    {
      "src": "/create-portal-session",
      "dest": "/api/index.py"
    },
    {
      "src": "/webhook",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/LandingPage(\\.html)?",
      "dest": "/index.html"
    },
    {
      "src": "/chat",
      "dest": "/chatbot.html"
    },
    {
      "src": "/chatbot(\\.html)?",
      "dest": "/chatbot.html"
    },
    {
      "src": "/signup",
      "dest": "/login.html"
    },
    {
      "src": "/login(\\.html)?",
      "dest": "/login.html"
    },
    {
      "src": "/pricing(\\.html)?",
      "dest": "/pricing.html"
    },
    {
      "src": "/dashboard(\\.html)?",
      "dest": "/dashboard.html"
    },
    {
      "src": "/lesson(\\.html)?",
      "dest": "/lesson.html"
    },
    {
      "src": "/onboarding(\\.html)?",
      "dest": "/onboarding.html"
    },
    {
      "src": "/teachroom(\\.html)?",
      "dest": "/teachroom.html"
    },
    {
      "src": "/teachstudio(\\.html)?",
      "dest": "/teachstudio.html"
    },
    {
      "src": "/course(\\.html)?",
      "dest": "/course.html"
    },
    {
      "src": "/new-subject(\\.html)?",
      "dest": "/new-subject.html"
    },
    {
      "src": "/notes(\\.html)?",
      "dest": "/notes.html"
    },
    {
      "src": "/admin(\\.html)?",
      "dest": "/admin.html"
    },
    {
      "src": "/voice-diagnostic(\\.html)?",
      "dest": "/voice-diagnostic.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
